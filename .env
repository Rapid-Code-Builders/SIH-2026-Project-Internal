# =============================================================================
# TideSense Environment Configuration
# =============================================================================
# Vite exposes env vars prefixed with VITE_ to the client-side code.
# Access via: import.meta.env.VITE_API_URL
#
# IMPORTANT: Never put secrets (API keys, passwords) in VITE_ vars —
# they are embedded in the JavaScript bundle and visible to anyone.
# The FastAPI backend handles all secret management.
# =============================================================================

VITE_API_URL=http://localhost:8000
